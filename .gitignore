# launch.ps1 运行时产物
.ssh-key
.ssh-key.pub
.tunnel.pid
.cloud-init.rendered.yaml

# workspace 是用户工作目录,不进 git
workspace/

# mounts.txt 是用户本地多目录挂载配置(基于 mounts.example.txt 复制),不进 git
mounts.txt

# bundle/ 二进制离线包(~113MB),只保留 bundle/README.md 进 git
bundle/*
!bundle/README.md

# 本地安装/进度测试脚本
test-progress.ps1

# Claude Code 本地权限设置(.local. 后缀,每台机器不同)
.claude/settings.local.json

.idea/